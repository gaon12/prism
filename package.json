{
  "name": "prism",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "check": "tsc -b --pretty false",
    "version:check": "node scripts/bump-version.mjs --check",
    "version:bump": "node scripts/bump-version.mjs",
    "test:version": "node --test tests/scripts/version.test.mjs",
    "test:manifest": "node --test tests/scripts/manifest.test.mjs",
    "release:manifest": "node scripts/make-latest-json.mjs",
    "release:config": "node scripts/release-config.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "test:release-config": "node --test tests/scripts/release-config.test.mjs",
    "test:release-checksums": "node --test tests/scripts/release-checksums.test.mjs",
    "build:update-verifier": "cargo build --manifest-path tools/update-verifier/Cargo.toml --locked",
    "test:release": "npm run build:update-verifier && node --test tests/scripts/version.test.mjs tests/scripts/manifest.test.mjs tests/scripts/release-config.test.mjs tests/scripts/release-checksums.test.mjs tests/scripts/release-signing.test.mjs",
    "test:setup-core": "cargo test --manifest-path installer/core/Cargo.toml",
    "build:setup": "cargo build --manifest-path installer/src-tauri/Cargo.toml --release",
    "test:setup": "node tests/native/setup.mjs",
    "test:setup-recovery": "node tests/native/setup-recovery.mjs",
    "test:setup-previous": "node tests/native/setup-previous.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:bundle": "node scripts/test-e2e-bundle.mjs",
    "test:native": "node tests/native/client.mjs",
    "test:standalone": "node tests/native/standalone.mjs",
    "test:clipboard": "node tests/native/clipboard.mjs",
    "test:clipboard-ui": "node tests/native/clipboard-ui.mjs",
    "test:paste": "node tests/native/paste.mjs",
    "test:updates": "node tests/native/updates.mjs",
    "test:diagnostics": "node tests/native/diagnostics.mjs",
    "test:platform-ui": "node tests/native/platform-ui.mjs",
    "test:content": "node tests/native/content.mjs",
    "test:dictionary": "node tests/native/dictionary.mjs",
    "test:rag": "node tests/native/rag.mjs",
    "test:search-chat": "node tests/native/search-chat.mjs",
    "test:chat-entry": "node tests/native/search-chat-entry.mjs",
    "test:short-paths": "node tests/native/short-paths.mjs",
    "test:documents": "node tests/native/documents.mjs",
    "test:onboarding": "node tests/native/onboarding.mjs",
    "test:portable": "node tests/native/portable.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "package:msix": "node scripts/package-msix.mjs",
    "test:msix": "node --test tests/scripts/msix.test.mjs",
    "format:check": "prettier --check src tests scripts .github tools/update-verifier/README.md tools/platform-qa/README.md vite.config.ts playwright.config.ts package.json tsconfig*.json index.html .prettierrc.json README.md",
    "test:rag-hybrid": "node tests/native/rag-hybrid.mjs"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "0.173.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "lucide-react": "1.68.0",
    "mathjs": "15.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
