{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "0.1.0",
  "identifier": "app.prism.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "Prism", "width": 1280, "height": 840, "minWidth": 760, "minHeight": 540, "decorations": false }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": { "pubkey": "", "requireSignedVersion": true, "endpoints": ["https://github.com/gaon12/prism/releases/latest/download/latest.json"], "windows": { "installMode": "passive" } }
  },
  "bundle": {
    "active": true,
    "resources": ["notices/pdf-renderer.txt", "notices/document-pdf.txt", "notices/document-hwpx.txt", "notices/office-passwords.txt"],
    "targets": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
