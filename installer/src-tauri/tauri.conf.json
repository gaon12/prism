{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism Setup",
  "version": "0.1.0",
  "identifier": "app.prism.setup",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "setup",
        "create": false,
        "title": "Prism Setup",
        "width": 760,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"] }
}
