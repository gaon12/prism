<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package description for Prism. scripts/package-msix.mjs fills the named template values.
  - Full-trust desktop app: Prism runs exactly like the normal build, just packaged.
  - Windows installs/updates/removes MSIX itself (Store or App Installer), so Prism's own
    updater must not install updates in this build; it only shows a notice.
  - Start on login uses the StartupTask below (id "PrismStartup"); the registry "Run" key that
    the normal build uses is not honoured for packaged apps.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">
  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Prism</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Search files, documents and clipboard items in one place.</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="ko-KR" />
    <Resource Language="en-US" />
    <Resource Language="zh-CN" />
    <Resource Language="zh-TW" />
    <Resource Language="ja-JP" />
  </Resources>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="Prism" Executable="prism.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Prism"
        Description="Search files, documents and clipboard items in one place."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="prism.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="PrismStartup" Enabled="false" DisplayName="Prism" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
